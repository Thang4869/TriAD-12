# Local development: Vite proxies /api to the backend on localhost:5000.
VITE_API_BASE_URL=/api

# On Vercel staging, set VITE_API_BASE_URL=/api in the project environment.
# vercel.json routes /api through the server-side authenticated proxy.
# Review that destination before deploying this configuration to another backend.
# Values prefixed with VITE_ are public browser configuration, not secrets.
# Keep database, SMTP, OAuth client secrets and payment secrets on the backend.
# Hosting only: set API_EDGE_SECRET (32+ random characters) on Vercel and Render.
# Never prefix this secret with VITE_; do not commit its value.
