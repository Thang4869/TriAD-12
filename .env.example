# Local development: Vite proxies /api to the backend on localhost:5000.
VITE_API_BASE_URL=/api

# On Vercel, override VITE_API_BASE_URL in the project environment settings
# with the actual deployed HTTPS API URL, including /api.
# Values prefixed with VITE_ are public browser configuration, not secrets.
# Keep database, SMTP, OAuth client secrets and payment secrets on the backend.
