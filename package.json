    "@vitest/ui": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.0.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.0.0",
    "@testing-library/dom": "^9.0.0",
    "jsdom": "^23.0.0"
  },
  "dependencies": {}
}